# ─────────────────────────────────────────────────────────────────────────────
# Searchzen environment variables
#
# You do NOT need this file for a normal installation: open your site in the
# browser and the web installer writes everything to storage/config.json.
#
# Use these variables only for Docker, Vercel, the worker, read-only hosting or
# advanced setups. Copy this file to `.env.local` (or set the variables in your
# hosting panel). Values set by the hosting panel or PM2 win over .env files.
# ─────────────────────────────────────────────────────────────────────────────

# Port the server listens on (server.js / npm start). HOST sets the address for server.js
# (default 0.0.0.0).
PORT=3000
# HOST=0.0.0.0

# Public address of the platform, used when "Site URL" is empty in Admin → Settings → General.
# Share links, the SEO health badge snippet (https://…/sz-badge.js), Google sign-in redirects,
# emails and the cron URL are built from it, so use your final https:// address.
# SITE_URL=https://seo.example.com

# Where config.json, the SQLite database and uploads (logos) are stored.
# STORAGE_DIR=/var/lib/searchzen

# Number of reverse proxies in front of the app that add X-Forwarded-For. Used to find the
# connecting IP for rate limits (sign-in, registration, cron URL, REST API).
# Default 1: Nginx, Apache/Passenger (cPanel) or Vercel. Use 2 for Cloudflare in front of Nginx.
# TRUSTED_PROXY_HOPS=1

# Database — overrides storage/config.json when set.
# Either one connection URL (cloud providers give you this)…
# DATABASE_URL=mysql://user:password@host:3306/searchzen?ssl=true
# …or separate values:
# DB_DRIVER=mysql            # mysql or sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=searchzen
# DB_USER=searchzen
# DB_PASSWORD=secret
# DB_SSL=true                # required by TiDB Cloud, Aiven, DigitalOcean and most cloud MySQL
# DB_FILE=database.sqlite    # SQLite only, relative to STORAGE_DIR

# Create (or promote) an administrator without the web installer (password: 8+ characters).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Administrator

# Fill an empty database once with sample data for a live demo: customers, plan payments and
# messages for the admin panel, plus sample SEO projects for the first administrator.
# Needs ADMIN_EMAIL/ADMIN_PASSWORD. Runs once per database.
# DEMO_SEED=true

# Skip the web installer when the database is configured with the variables above
# (e.g. Vercel). Tables are created automatically; use ADMIN_* for the first administrator.
# APP_INSTALLED=true

# Keep Server Action ids stable across multiple servers / rebuilds (optional).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Demo mode: the admin panel and the customer dashboard are read-only and registration is closed.
# Use this for a public live demo.
# DEMO_MODE=true

# Secret for the scheduler URL /api/cron/tick and for `npm run worker` (background jobs:
# rank checks, site audit crawling, Search Console imports, scheduled reports).
# Without it, one is generated, stored in the database and shown in Admin → System → Scheduler.
# Use at least 12 random characters (e.g. `openssl rand -hex 24`); shorter values and the
# example value "change-me-to-a-long-random-string" are ignored by the app.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# ecosystem.config.cjs and docker-compose.yml need it in their environment for the worker.
# CRON_SECRET=a-long-random-string

# Worker only (npm run worker): address of the app (default SITE_URL, else
# http://localhost:$PORT) and seconds between ticks (default 15, minimum 5).
# WORKER_URL=http://localhost:3000
# WORKER_INTERVAL_SEC=15

# App secret (at least 16 random characters, e.g. `openssl rand -hex 32`). Encrypts the Google
# Search Console refresh tokens (AES-256-GCM) and signs the Google sign-in state and the cookies
# of password-protected reports. Without it, one is generated and saved in storage/config.json
# (or in the database when that file can't be written).
# SET IT on Vercel / serverless hosts and whenever several servers or containers run the app,
# so they all use the same secret. NEVER change it afterwards: tokens encrypted with the old
# secret can't be read, and customers must reconnect Google Search Console.
# APP_SECRET=a-long-random-string-of-at-least-16-characters

# ── Rank tracking (SERP data provider) ──

# Optional: API keys can be pasted in Admin → Settings → Rank tracking instead. A key set here
# wins over the admin panel (the field is then locked). Keys are never sent to browsers.
# SERPER_API_KEY=
# SERPAPI_API_KEY=
# DataForSEO needs both (API login and API password from the DataForSEO dashboard):
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# VALUESERP_API_KEY=
# Provider to use when none is chosen in the admin panel (a provider saved there wins):
# serper, serpapi, dataforseo, valueserp or simulated (fake positions, demos and testing only).
# SERP_PROVIDER=serper

# ── Alerts ──

# Allow webhook alert channels to post to private / internal addresses (localhost, 10.x,
# 192.168.x …), e.g. n8n on your own network. Only for single-company installations:
# on a public platform it would let customers reach your internal network.
# ALLOW_PRIVATE_WEBHOOKS=1

# ── Development and testing only: NEVER set these in production ──

# TESTING ONLY, NEVER IN PRODUCTION: let the site audit crawler fetch private / local addresses
# (127.0.0.1, 10.x …) and non-standard ports, for automated tests against a local fixture site.
# On a real installation any customer could make the server crawl your internal network.
# ALLOW_PRIVATE_CRAWL=true

# TESTING ONLY, NEVER IN PRODUCTION: point Google sign-in and the Search Console API at a local
# mock server for automated tests. GOOGLE_OAUTH_BASE replaces accounts.google.com /
# oauth2.googleapis.com ({base}/o/oauth2/v2/auth, {base}/token, {base}/revoke, {base}/v1/userinfo);
# GSC_API_BASE replaces https://www.googleapis.com/webmasters/v3. In production they would send
# your customers' Google sign-ins and tokens to the wrong server.
# GOOGLE_OAUTH_BASE=http://127.0.0.1:5431
# GSC_API_BASE=http://127.0.0.1:5431/webmasters/v3

# Build folder of Next.js (default .next). Lets a second development server run from the
# same folder, e.g. NEXT_DIST_DIR=.next-test. Don't set it in production.
# NEXT_DIST_DIR=.next

# Set automatically by the platform, don't set them yourself: NODE_ENV, NEXT_PHASE (Next.js),
# VERCEL and VERCEL_PROJECT_PRODUCTION_URL (Vercel; the production domain is the last fallback
# for SITE_URL).
